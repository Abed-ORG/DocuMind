NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_BATCH_SIZE=8
GEMINI_EMBEDDING_REQUEST_DELAY_MS=250
GEMINI_EMBEDDING_TIMEOUT_MS=30000
GEMINI_GENERATIVE_MODEL=gemini-flash-latest
GEMINI_GENERATIVE_TIMEOUT_MS=30000
AI_INPUT_COST_PER_MILLION_TOKENS=0.75
AI_OUTPUT_COST_PER_MILLION_TOKENS=3.75
VECTOR_SEARCH_INDEX_NAME=chunk_embedding_vector_index

# Document storage: local or r2. If omitted, the backend uses r2 when all R2
# values are present, otherwise local.
DOCUMENT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=documind-documents
R2_ENDPOINT=
